# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=


# ==========================================
# Redis
# ==========================================

REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_NAME=document_queue


# ==========================================
# Local Storage
# ==========================================

# Change these paths according to your local environment
STORAGE_ROOT=./storage/uploads
MARKER_OUTPUT_FOLDER=./storage/marker_outputs


# ==========================================
# Document Processing
# ==========================================

CHUNK_MAX_CHARACTERS=6000


# ==========================================
# Embeddings
# ==========================================

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768


# ==========================================
# LLM - Groq
# ==========================================

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_MODEL=


# ==========================================
# Marker / OCR
# ==========================================

# Path to llama.cpp executable.
# Update this path according to your local environment.
LLAMA_CPP_BINARY=